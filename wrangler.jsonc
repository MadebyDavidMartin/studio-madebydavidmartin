{
  // Cloudflare Worker serving studio.madebydavidmartin.com and fizola.madebydavidmartin.com
  // from the static files in public/. src/index.js routes by address (see comments there).
  "name": "studio-madebydavidmartin",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
